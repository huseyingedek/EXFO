# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local development and fill in the values.
# On Vercel: Project → Settings → Environment Variables.
# Never commit your real `.env` file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin panel login (/admin/login) ─────────────────────────────────────────
# 1. Choose the admin e-mail address:
ADMIN_EMAIL=
# 2. Generate the two values below with:
#      node scripts/hash-password.mjs "your-strong-password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ── GoHighLevel (CRM) ────────────────────────────────────────────────────────
# Private Integration API key: GHL → Settings → Integrations → Private Integration
GHL_API_KEY=
# Location (sub-account) ID: GHL → Settings → Business Info → Location ID
GHL_LOCATION_ID=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key from the Stripe Dashboard (sk_test_... / sk_live_...)
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Endpoint: https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional: use Prices created in the Stripe Dashboard instead of the amounts
# in src/config/plans.json. Leave empty to use plans.json.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_VIP_YEARLY=
