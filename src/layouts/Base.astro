---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import {
  defaultLang,
  languages,
  langs,
  useTranslations,
  type Lang,
} from "@/i18n/config";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  lang?: Lang;
  /** URL of this same page in every language (hreflang + language switcher). */
  alternates?: Partial<Record<Lang, string>>;
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const {
  lang = defaultLang,
  alternates = {},
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
} = Astro.props;

const t = useTranslations(lang);
const baseUrl = config.site.base_url.replace(/\/$/, "");
const absolute = (p: string) => `${baseUrl}${p === "/" ? "" : p}` || baseUrl;

const clean = (value: string) => plainify(value).replace(/\s+/g, " ").trim();
const rawTitle = meta_title ?? title;
const pageTitle = rawTitle
  ? clean(rawTitle) +
    (clean(rawTitle).includes(t.meta.site_title) ? "" : t.meta.title_suffix)
  : t.meta.site_title;
const pageDescription = clean(description ?? t.meta.description);
const pageUrl = canonical ?? absolute(Astro.url.pathname.replace(/\/$/, "") || "/");
const ogImage = `${baseUrl}${image ? image : config.metadata.meta_image}`;
const hreflangs = langs
  .filter((l) => alternates[l])
  .map((l) => ({ hreflang: languages[l].htmlLang, href: absolute(alternates[l]!) }));
const xDefault = alternates[defaultLang];
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <meta charset="UTF-8" />
    <link rel="shortcut icon" href={config.site.favicon} />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="theme-name" content="efxo-market-miners" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" content="#060606" />
    <meta name="generator" content={Astro.generator} />

    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- language alternates -->
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}

    <meta name="author" content={config.metadata.meta_author} />
    <meta property="og:site_name" content={t.meta.site_title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      langs
        .filter((l) => l !== lang && alternates[l])
        .map((l) => (
          <meta property="og:locale:alternate" content={languages[l].ogLocale} />
        ))
    }
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- GSAP CDN -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
    ></script>

    <!-- LENIS CDN -->
    <script
      is:inline
      defer
      src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>

    <!-- Main UI interactions -->
    <script is:inline defer src="/scripts/main.js"></script>

    <!-- Animations (Modules are deferred automatically by browsers) -->
    <script is:inline type="module" src="/scripts/animations.js"></script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <Header lang={lang} alternates={alternates} />
    <main id="main-content" class="overflow-x-hidden md:overflow-x-auto">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
