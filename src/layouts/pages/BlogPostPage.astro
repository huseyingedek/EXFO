---
import Share from "@/components/Share.astro";
import { langs, path, useTranslations, type Lang } from "@/i18n/config";
import Base from "@/layouts/Base.astro";
import BlogCard from "@/layouts/components/BlogCard.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import { getSinglePage, type LocalizedEntry } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import { getCollection, render } from "astro:content";

interface Props {
  lang: Lang;
  post: LocalizedEntry<"blog">;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const base = path("insights", lang);
const postData = post.data;
const { Content } = await render(post);

// Same article in the other language(s) — matched by file name
const allIds = new Set((await getCollection("blog")).map((p) => p.id));
const alternates = Object.fromEntries(
  langs.map((l) => [
    l,
    allIds.has(`${l}/${post.slug}`)
      ? `${path("insights", l)}/${post.slug}`
      : path("insights", l),
  ]),
) as Record<Lang, string>;

// Related posts (newest first, same language)
const allPosts = sortByDate(await getSinglePage("blog", lang));
const relatedPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);
---

<Base {...postData} lang={lang} alternates={alternates}>
  <!-- Blog Single Hero -->
  <section class="section-ph relative pb-10 lg:pb-14">
    <div class="container">
      <div class="mx-auto max-w-246.25 text-center">
        {
          postData.tag && (
            <a
              href={base}
              class="mb-6 inline-flex rounded-[10px] bg-white px-2.5 py-1.5 text-sm leading-5 text-dark"
            >
              {postData.tag}
            </a>
          )
        }
        <h1
          class="hasHighlight mb-8 text-h4-sm md:text-h1 leading-[1.1]"
          set:html={markdownify(postData.title)}
        />

        <div class="overflow-hidden rounded-2xl border border-white/10">
          <ImageMod
            src={postData.image ?? "/images/blog/featured-cover.png"}
            alt=""
            width={1200}
            height={630}
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>

        <div
          class="mx-auto mt-6 flex max-w-140 flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm md:text-base text-text"
        >
          <span class="inline-flex items-center gap-2">
            <ImageMod
              src={postData.author_image ?? "/images/efxo-mark.png"}
              width={24}
              height={24}
              class="size-6 rounded-full"
              alt=""
            />
            {postData.author}
          </span>
          <span class="inline-flex items-center gap-2">
            <svg class="size-3.5 shrink-0 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
            <time datetime={(postData.date ?? new Date()).toISOString()}>
              {dateFormat(postData.date ?? new Date(), lang)}
            </time>
          </span>
          {
            postData.read_time && (
              <span class="inline-flex items-center gap-2">
                <svg class="size-3.5 shrink-0 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                {postData.read_time}
              </span>
            )
          }
        </div>

        <hr
          class="mt-8 h-px border-0 bg-linear-to-r from-transparent via-white/15 to-transparent"
        />
      </div>
    </div>

    <div class="absolute inset-0 h-full w-full overflow-hidden -z-10">
      <canvas class="heroSporeCanvas w-full opacity-70"></canvas>
    </div>
    <div
      class="absolute left-1/2 top-0 -z-20 size-170 -translate-x-1/2 -translate-y-1/2 blur-2xl xl:size-300"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 h-40 w-full -z-10 bg-linear-180 from-transparent to-body"
    >
    </div>
  </section>

  <!-- Article Content -->
  <section class="section pt-0 lg:pt-6">
    <div class="container">
      <div class="mx-auto flex max-w-200 flex-col gap-16">
        <article>
          <div class="content">
            <Content />
          </div>
        </article>

        <!-- Share -->
        <div class="flex flex-wrap items-center gap-6 md:gap-8">
          <h2 class="text-h5 md:text-h4 mb-0">{t.common.share}</h2>
          <Share
            className="social-icons"
            pagePath={`${base}/${post.slug}`}
            title={postData.title}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Read More -->
  {
    relatedPosts.length > 0 && (
      <section class="section pb-20">
        <div class="container relative isolate">
          <div class="mb-12 text-center">
            <h2 class="text-h3-sm md:text-h2">{t.common.related_posts}</h2>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {relatedPosts.map((relPost) => (
              <BlogCard
                image={relPost.data.image ?? "/images/blog/post-1.png"}
                imageAlt=""
                title={relPost.data.title}
                description={relPost.data.description ?? ""}
                authorImage={relPost.data.author_image ?? "/images/efxo-mark.png"}
                authorName={relPost.data.author}
                date={dateFormat(relPost.data.date ?? new Date(), lang)}
                href={`${base}/${relPost.slug}`}
              />
            ))}
          </div>

          <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-310.5 -translate-x-1/2 -translate-y-1/3 rounded-full bg-radial from-primary/16 from-0% to-transparent to-70% blur-2xl" />
        </div>
      </section>
    )
  }

  <CallToAction lang={lang} />
</Base>
