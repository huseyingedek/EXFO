---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import GHLMeeting from "@/layouts/partials/GHLMeeting.astro";
import { getListPage } from "@/lib/contentParser.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import { alternatesFor, isExternal, useTranslations, type Lang } from "@/i18n/config";
import type { Contact } from "@/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = await getListPage("contact", "-index", lang);
const contactData: Contact = contact.data;
const inputClass =
  "w-full rounded-full bg-white/5 backdrop-blur-[44px] px-8 py-5 border border-border text-white placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors";
---

<Base {...contactData} lang={lang} alternates={alternatesFor("contact")}>
  <PageHeader
    title={contactData.page_header!.title}
    subtitle={contactData.page_header!.subtitle}
  />

  <!-- Contact Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row g-7 max-lg:gap-5">
        <!-- Left Column - Contact Cards -->
        <div class="col-12 lg:col-5">
          <div class="flex flex-col gap-5">
            {
              contactData.contact_info?.enable &&
                contactData.contact_info.items.map((item) => {
                  const Container = item.type === "calendar" ? "div" : "a";
                  const href = item.link || (item.type === "email" ? `mailto:${item.detail}` : item.type === "phone" ? `tel:${item.detail}` : undefined);
                  
                  return (
                    <Container
                      href={Container === "a" ? href : undefined}
                      target={Container === "a" && href && isExternal(href) ? "_blank" : undefined}
                      rel={Container === "a" && href && isExternal(href) ? "noopener noreferrer" : undefined}
                      class={`flex flex-col gap-5 p-7 md:p-8 bg-white/5 rounded-2xl cursor-pointer hover:bg-white/10 transition-all duration-300 ring-1 ring-white/10 hover:ring-primary/50 group hover:scale-[1.02]`}
                      data-ghl-trigger={item.type === "calendar" ? "true" : undefined}
                    >
                    <div class="w-10 h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                      <DynamicIcon
                        icon={item.icon ?? ""}
                        className="w-10 h-10 text-white"
                      />
                    </div>
                    <div class="flex flex-col gap-3">
                      <h3 class="font-secondary font-bold text-2xl text-white">
                        {item.title}
                      </h3>
                      <p class="text-text text-lg">{item.detail}</p>
                    </div>
                    </Container>
                  );
                })
            }
          </div>
        </div>

        <!-- Right Column - Contact Form -->
        <div class="col-12 lg:col-7">
          <div class="p-8 md:p-10 bg-white/5 rounded-2xl">
            {contactData.form_title && (
              <h2 class="text-h4-sm md:text-h4 mb-8">{contactData.form_title}</h2>
            )}
            <form
              id="contact-form"
              novalidate
              class="flex flex-col gap-10"
              data-lang={lang}
              data-error-required={t.forms.error_required}
              data-error-generic={t.forms.error_generic}
              data-error-network={t.forms.error_network}
            >
              <div class="flex flex-col gap-5">
                <div class="relative">
                  <label class="sr-only" for="cf-name">{t.forms.name}</label>
                  <input id="cf-name" type="text" name="name" autocomplete="name" placeholder={t.forms.name} required class={inputClass} />
                </div>
                <div class="relative">
                  <label class="sr-only" for="cf-email">{t.forms.email}</label>
                  <input id="cf-email" type="email" name="email" autocomplete="email" placeholder={t.forms.email} required class={inputClass} />
                </div>
                <div class="relative">
                  <label class="sr-only" for="cf-phone">{t.forms.phone}</label>
                  <input id="cf-phone" type="tel" name="phone" autocomplete="tel" placeholder={t.forms.phone} class={inputClass} />
                </div>
                <div class="relative">
                  <label class="sr-only" for="cf-message">{t.forms.message}</label>
                  <textarea
                    id="cf-message"
                    name="message"
                    placeholder={t.forms.message}
                    rows={5}
                    required
                    class="w-full rounded-[20px] bg-white/5 backdrop-blur-[44px] px-8 py-5 border border-border text-white placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors resize-none"
                  ></textarea>
                </div>
              </div>
              <div class="flex flex-col gap-6">
                <!-- Status messages -->
                <div
                  id="form-success"
                  class="hidden rounded-2xl bg-green-500/10 border border-green-500/30 px-6 py-4 text-green-400 text-base"
                >
                  {t.forms.success_contact}
                </div>
                <div
                  id="form-error"
                  class="hidden rounded-2xl bg-red-500/10 border border-red-500/30 px-6 py-4 text-red-400 text-base"
                >
                  <span id="form-error-text">{t.forms.error_generic}</span>
                </div>

                <button
                  type="submit"
                  id="contact-submit"
                  class="btn btn-primary w-full py-4 text-lg font-medium transition-opacity disabled:opacity-60 disabled:cursor-not-allowed"
                >
                  <span id="submit-label">{t.forms.submit_contact}</span>
                  <span id="submit-loading" class="hidden">{t.forms.sending}</span>
                </button>
                <p class="text-sm text-text-dark text-center" set:html={t.forms.consent} />
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Faq lang={lang} />

  <!-- Call to Action -->
  <CallToAction lang={lang} />

  {/* GHL Meeting Modal */}
  {
    contactData.contact_info?.items.find((i) => i.type === "calendar") && (
      <GHLMeeting
        schedulerUrl={
          contactData.contact_info.items.find((i) => i.type === "calendar")
            ?.link
        }
      />
    )
  }
</Base>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const submitBtn = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement | null;
  const submitLabel = document.getElementById("submit-label");
  const submitLoading = document.getElementById("submit-loading");
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");
  const errorText = document.getElementById("form-error-text");

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel || !submitLoading) return;
    submitBtn.disabled = loading;
    submitLabel.classList.toggle("hidden", loading);
    submitLoading.classList.toggle("hidden", !loading);
  }

  function showSuccess() {
    successEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    form?.reset();
  }

  function showError(msg?: string) {
    errorEl?.classList.remove("hidden");
    successEl?.classList.add("hidden");
    if (errorText && msg) errorText.textContent = msg;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Hide previous status
    successEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");

    const formData = new FormData(form!);
    const name = String(formData.get("name") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError(form?.dataset.errorRequired);
      return;
    }
    setLoading(true);

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          email,
          phone: formData.get("phone"),
          message: formData.get("message"),
          lang: form?.dataset.lang,
        }),
      });

      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        showSuccess();
      } else {
        showError(form?.dataset.errorGeneric);
      }
    } catch {
      showError(form?.dataset.errorNetwork);
    } finally {
      setLoading(false);
    }
  });
</script>
