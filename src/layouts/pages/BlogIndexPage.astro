---
import Base from "@/layouts/Base.astro";
import BlogCard from "@/layouts/components/BlogCard.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import FeaturedPostCard from "@/layouts/components/FeaturedPostCard.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import { alternatesFor, path, useTranslations, type Lang } from "@/i18n/config";
import type { BlogIndex } from "@/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = path("insights", lang);

// Page-level content from content collection
const blogIndex = await getListPage("blogIndex", "-index", lang);
const pageData: BlogIndex = blogIndex.data;

// All blog posts of this language, sorted by date
const allPosts = sortByDate(await getSinglePage("blog", lang));

// Featured post: use the one specified in content, fallback to first
const featuredId = pageData.page_header?.featured_post;
const featuredPost = featuredId
  ? (allPosts.find((p) => p.slug === featuredId) ?? allPosts[0])
  : allPosts[0];
const latestPosts = allPosts.filter((p) => p.id !== featuredPost?.id);
---

<Base {...pageData} lang={lang} alternates={alternatesFor("insights")}>
  <!-- Page Header -->
  <section class="section-ph pb-10 relative">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full opacity-70"></canvas>
        </div>
      </div>
      <div class="lg:max-w-4xl mx-auto text-center relative z-10">
        <h1
          class="hasHighlight mb-0"
          set:html={markdownify(pageData.page_header?.title ?? pageData.title)}
        />
        {pageData.page_header?.subtitle && (
          <p class="mt-6 text-lg text-text lg:max-w-2xl mx-auto">{pageData.page_header.subtitle}</p>
        )}
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>

  <!-- Featured Article -->
  {
    featuredPost && (pageData.featured_post?.enable ?? true) && (
      <section class="section pt-0">
        <div class="container">
          <div class="grid gap-4 lg:grid-cols-[1fr_1.03fr]">
            <a href={`${base}/${featuredPost.slug}`} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-2xl border border-white/10">
              <ImageMod
                src={
                  featuredPost.data.image ?? "/images/blog/featured-cover.png"
                }
                alt={featuredPost.data.title}
                width={700}
                height={500}
                class="h-full w-full object-cover"
              />
            </a>
            <FeaturedPostCard
              tag={featuredPost.data.tag ?? t.common.featured}
              title={featuredPost.data.title}
              description={featuredPost.data.description ?? ""}
              authorImage={
                featuredPost.data.author_image ?? "/images/blog/author-1.png"
              }
              authorName={featuredPost.data.author}
              date={dateFormat(featuredPost.data.date ?? new Date(), lang)}
              readTime={featuredPost.data.read_time ?? `5 ${t.common.min_read}`}
              href={`${base}/${featuredPost.slug}`}
            />
          </div>

          <hr class="mt-16 h-px border-0 bg-linear-to-r from-transparent via-white/15 to-transparent" />
        </div>
      </section>
    )
  }

  <!-- Latest Articles -->
  {
    latestPosts.length > 0 && (pageData.latest_posts?.enable ?? true) && (
      <section class="section pt-10 lg:pt-14">
        <div class="container relative isolate">
          <div class="mb-12 text-center">
            <h2 class="text-h3-sm md:text-h2">
              {pageData.latest_posts?.title ?? t.common.latest_posts}
            </h2>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {latestPosts.map((post) => (
              <BlogCard
                image={post.data.image ?? "/images/blog/post-1.png"}
                imageAlt={post.data.title}
                title={post.data.title}
                description={post.data.description ?? ""}
                authorImage={
                  post.data.author_image ?? "/images/blog/author-1.png"
                }
                authorName={post.data.author}
                date={dateFormat(post.data.date ?? new Date(), lang)}
                href={`${base}/${post.slug}`}
              />
            ))}
          </div>

          <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-310.5 -translate-x-1/2 -translate-y-1/3 rounded-full bg-radial from-primary/16 from-0% to-transparent to-70% blur-2xl" />
        </div>
      </section>
    )
  }

  <!-- Call to Action -->
  <CallToAction lang={lang} />
</Base>
