---
import ImageMod from "@/layouts/components/ImageMod.astro";
import { useTranslations, type Lang } from "@/i18n/config";
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  lang: Lang;
  lead_generation: any;
}

const { lang, lead_generation } = Astro.props;
const t = useTranslations(lang);
---

<section class="section-box bg-transparent my-0 pb-0" id="free-guide">
  <div class="container-sm">
    <div class="section-container pb-20">
      <div class="section-intro centralize">
        <h2
          class="title hasHighlight  "
          set:html={lead_generation.title}
        />
      </div>
      <div class="section-content">
        <div class="flex flex-col-reverse lg:flex-row gap-x-20 gap-y-10">
          <div class="lg:w-6/12">
            <h3 class="text-h5-sm font-bold mb-7">
              {lead_generation.subtitle}
            </h3>
            <div
              class="space-y-4"
              set:html={markdownify(lead_generation.content, true)}
            />
            <ul class="green-tick-list [&>li]:mb-8 mt-10">
              {lead_generation.list.map((item: string) => (
                <li set:html={markdownify(item)} />
              ))}
            </ul>
          </div>
          <div class="lg:w-6/12">
            <div class="bg-light rounded-4xl corner-squircle p-10 xl:px-7.5 xl:py-10">
              <ImageMod
                src={lead_generation.image}
                width={640}
                height={440}
                alt={lead_generation.image_alt ?? ""}
                class="w-full max-w-80 h-auto mx-auto mb-8"
              />
              <form
                id="lead-form"
                novalidate
                data-lang={lang}
                data-error-required={t.forms.error_required}
                data-error-generic={t.forms.error_generic}
                data-error-network={t.forms.error_network}
              >
                <div class="form-control">
                  <label class="sr-only" for="lead-name">{t.forms.name}</label>
                  <input
                    id="lead-name"
                    type="text"
                    name="name"
                    autocomplete="given-name"
                    placeholder={t.forms.name}
                    class="form-input w-full mb-5"
                    required
                  />
                  <label class="sr-only" for="lead-email">{t.forms.email}</label>
                  <input
                    id="lead-email"
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder={t.forms.email}
                    class="form-input w-full mb-5"
                    required
                  />
                  <button
                    type="submit"
                    id="lead-submit"
                    class="btn btn-primary w-full disabled:opacity-60 disabled:cursor-not-allowed"
                  >
                    <span id="lead-submit-label">{t.forms.lead_submit}</span>
                    <span id="lead-submit-loading" class="hidden">{t.forms.sending}</span>
                  </button>
                  <div
                    id="lead-form-success"
                    class="hidden mt-4 text-green-500 font-medium text-sm text-center"
                  >
                    {t.forms.success_lead}
                  </div>
                  <div
                    id="lead-form-error"
                    class="hidden mt-4 text-red-500 font-medium text-sm text-center"
                  >
                    <span id="lead-form-error-text">{t.forms.error_generic}</span>
                  </div>
                  <p class="mt-4 text-xs text-text-dark text-center" set:html={t.forms.consent} />
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <hr class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0" />
</section>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("lead-submit") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("lead-submit-label");
  const submitLoading = document.getElementById("lead-submit-loading");
  const successEl = document.getElementById("lead-form-success");
  const errorEl = document.getElementById("lead-form-error");
  const errorText = document.getElementById("lead-form-error-text");

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel || !submitLoading) return;
    submitBtn.disabled = loading;
    submitLabel.classList.toggle("hidden", loading);
    submitLoading.classList.toggle("hidden", !loading);
  }

  function showSuccess() {
    successEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    form?.reset();
  }

  function showError(msg?: string) {
    errorEl?.classList.remove("hidden");
    successEl?.classList.add("hidden");
    if (errorText && msg) errorText.textContent = msg;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Hide previous status
    successEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");

    const formData = new FormData(form!);
    const name = String(formData.get("name") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError(form?.dataset.errorRequired);
      return;
    }
    setLoading(true);

    try {
      const res = await fetch("/api/lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, lang: form?.dataset.lang }),
      });

      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        showSuccess();
      } else {
        showError(form?.dataset.errorGeneric);
      }
    } catch {
      showError(form?.dataset.errorNetwork);
    } finally {
      setLoading(false);
    }
  });
</script>
