---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  image: string;
  imageAlt: string;
  title: string;
  description: string;
  authorImage: string;
  authorName: string;
  date: string;
  href: string;
  cardClass?: string;
}
const {
  image,
  imageAlt,
  title,
  description,
  authorImage,
  authorName,
  date,
  href,
  cardClass = "",
} = Astro.props;
---

<article class="flex flex-col justify-between">
  <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-2xl mb-2.5">
    <ImageMod
      src={image}
      alt={imageAlt}
      width={600}
      height={315}
      class="w-full aspect-[1200/630] object-cover rounded-2xl transition-transform duration-500 hover:scale-[1.03]"
    />
  </a>
  <div
    class={`rounded-2xl overflow-hidden bg-text-light/5 p-6 h-full flex flex-col justify-between ${cardClass}`}
  >
    <div>
      <a href={href} class="hover:text-primary! hover:underline">
        <h3 class="mb-3 text-h5-sm text-white">{title}</h3>
      </a>
      <p class="mb-5 text-sm leading-6 text-text">{description}</p>
    </div>
    <div>
      <hr
        class="mb-4 h-px border-0 bg-linear-to-r from-transparent via-white/10 to-transparent"
      />
      <div class="flex items-center justify-between gap-2 text-sm text-text">
        <span class="inline-flex items-center gap-2">
          <ImageMod
            src={authorImage}
            width={20}
            height={20}
            class="size-5 rounded-full"
            alt={authorName}
          />
          {authorName}
        </span>
        <span class="inline-flex items-center gap-2">
          <svg class="size-3.5 shrink-0 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          {date}
        </span>
      </div>
    </div>
  </div>
</article>
