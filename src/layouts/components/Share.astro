---
import config from "@/config/config.json";
import { FaFacebook, FaLinkedin, FaWhatsapp, FaXTwitter } from "react-icons/fa6";

interface Props {
  title?: string;
  /** Path of the page to share, e.g. "/analyses/forex-basics" */
  pagePath: string;
  className?: string;
}

const { title = "", pagePath, className }: Props = Astro.props;
const base = config.site.base_url.replace(/\/$/, "");
const url = encodeURIComponent(`${base}${pagePath}`);
const text = encodeURIComponent(title);

const links = [
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
    Icon: FaLinkedin,
  },
  {
    label: "X",
    href: `https://x.com/intent/post?url=${url}&text=${text}`,
    Icon: FaXTwitter,
  },
  {
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
    Icon: FaFacebook,
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/?text=${text}%20${url}`,
    Icon: FaWhatsapp,
  },
];
---

<ul class={className}>
  {
    links.map(({ label, href, Icon }) => (
      <li class="inline-block">
        <a
          aria-label={`Share on ${label}`}
          href={href}
          target="_blank"
          rel="noreferrer noopener"
        >
          <Icon />
        </a>
      </li>
    ))
  }
</ul>
