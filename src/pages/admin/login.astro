---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAdminConfig } from "@/lib/auth";

export const prerender = false;

// Already signed in? Go straight to the dashboard.
if (Astro.locals.admin) {
  return Astro.redirect("/admin/dashboard", 302);
}

const { configured } = getAdminConfig();
---

<AdminLayout title="Admin sign in">
  <main class="relative min-h-screen flex items-center justify-center px-6 overflow-hidden">
    <!-- gold glow backdrop -->
    <div
      class="absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2 size-[520px] -z-10 blur-3xl opacity-40"
      style="background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);"
    >
    </div>

    <div class="w-full max-w-md">
      <!-- brand -->
      <div class="text-center mb-8">
        <img src="/images/efxo-mark.png" alt="EFXO" class="size-20 mx-auto rounded-2xl ring-1 ring-primary/30 mb-4 object-cover" />
        <h1 class="text-3xl font-bold text-white tracking-[0.2em]">EFXO</h1>
        <p class="text-text-dark mt-1 text-sm uppercase tracking-[0.3em]">Market Miners</p>
      </div>

      <!-- card -->
      <div class="bg-light/80 backdrop-blur-xl border border-border rounded-3xl p-8 shadow-2xl">
        <h2 class="text-xl font-bold text-white mb-1">Admin panel</h2>
        <p class="text-text-dark text-sm mb-7">Sign in with your administrator account to continue.</p>

        {
          !configured && (
            <div class="mb-6 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-300">
              Admin login is not configured yet. Set <code>ADMIN_EMAIL</code>,
              <code>ADMIN_PASSWORD_HASH</code> and <code>ADMIN_SESSION_SECRET</code> in
              your environment variables (see <code>.env.example</code>).
            </div>
          )
        }

        <form id="login-form" class="flex flex-col gap-5" novalidate>
          <div>
            <label class="block text-sm text-text mb-2" for="email">Email</label>
            <input
              id="email" name="email" type="email" required autocomplete="username"
              placeholder="admin@efxo.com"
              class="w-full rounded-xl bg-body border border-border px-4 py-3 text-white placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors"
            />
          </div>
          <div>
            <label class="block text-sm text-text mb-2" for="password">Password</label>
            <input
              id="password" name="password" type="password" required autocomplete="current-password"
              placeholder="••••••••"
              class="w-full rounded-xl bg-body border border-border px-4 py-3 text-white placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors"
            />
          </div>
          <label class="flex items-center gap-2 text-sm text-text-dark cursor-pointer select-none">
            <input type="checkbox" name="remember" class="accent-[var(--color-primary)]" /> Keep me signed in for 30 days
          </label>

          <button
            id="login-submit"
            type="submit"
            class="btn btn-primary w-full !py-3 mt-1 disabled:opacity-60 disabled:cursor-not-allowed"
          >Sign in</button>

          <div
            id="login-error"
            role="alert"
            class="hidden text-center text-sm rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 px-4 py-3"
          ></div>
        </form>
      </div>

      <p class="text-center text-text-dark text-sm mt-6">
        <a href="/" class="hover:text-primary transition-colors">← Back to the website</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const errorEl = document.getElementById("login-error");
    const submit = document.getElementById("login-submit") as HTMLButtonElement | null;

    const messages: Record<string, string> = {
      invalid_credentials: "Incorrect email or password.",
      too_many_attempts: "Too many attempts. Please wait 15 minutes and try again.",
      not_configured: "Admin login is not configured on the server.",
    };

    const showError = (msg: string) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    };

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl?.classList.add("hidden");
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      const password = String(data.get("password") ?? "");
      if (!email || !password) {
        showError("Please enter your email and password.");
        return;
      }
      if (submit) submit.disabled = true;
      try {
        const res = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password, remember: data.get("remember") === "on" }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          window.location.href = "/admin/dashboard";
          return;
        }
        showError(messages[json.error] ?? "Sign in failed. Please try again.");
      } catch {
        showError("Network error. Please try again.");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  </script>
</AdminLayout>
